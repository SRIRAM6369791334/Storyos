{
  "name": "storyos-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "StoryOS — Enterprise AI Story Operating System Monorepo",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nx run-many --target=serve --all --parallel",
    "build": "nx run-many --target=build --all --parallel",
    "test": "vitest run",
    "test:unit": "vitest run --selectProjects unit",
    "test:integration": "vitest run --selectProjects integration",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "husky install",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@nx/devkit": "19.5.3",
    "@nx/eslint": "19.5.3",
    "@nx/eslint-plugin": "19.5.3",
    "@nx/js": "19.5.3",
    "@nx/workspace": "19.5.3",
    "@types/node": "20.14.10",
    "@typescript-eslint/eslint-plugin": "7.16.0",
    "@typescript-eslint/parser": "7.16.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "husky": "9.0.11",
    "lint-staged": "15.2.7",
    "nx": "19.5.3",
    "prettier": "3.3.2",
    "typescript": "5.5.3",
    "vite-tsconfig-paths": "4.3.2",
    "vitest": "2.0.2"
  },
  "dependencies": {
    "dotenv": "16.4.5",
    "reflect-metadata": "0.2.2",
    "tslib": "2.6.3",
    "zod": "3.23.8"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
